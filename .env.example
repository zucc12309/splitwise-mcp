# Load through your MCP host/secret manager. Never commit a populated copy.
SW_OWNER=your-private-owner-label
SW_ACCOUNT_ID=123456
SW_API_KEY=replace-through-secret-manager
SW_DATABASE=/absolute/private/path/state.sqlite
SW_REMOTE=false
SW_ENABLE_WRITES=false
# Base64url raw Ed25519 public key ONLY. Private key belongs to independent human signer.
SW_APPROVAL_PUBLIC_KEY=
# Optional remote-only settings:
SW_CALLER_TOKEN_SHA256=
SW_ALLOWED_HOST=
PORT=8000
SW_FIXTURE=false

# Only for a public setup homepage: exposes NO MCP tools and opens NO database.
SW_SETUP_ONLY=false
